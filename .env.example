# Set the base URL explicitly; custom Responses-compatible endpoints are supported.
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
# Required for CLI, provider checks and source records. Web debates have a model picker.
# Use an exact model identifier available at your endpoint.
NEBIUS_MODEL=

# Persona compilation requires file-backed ChatGPT OAuth credentials.
# Run: codex -c 'cli_auth_credentials_store="file"' login
# CODEX_HOME defaults to ~/.codex. API-key login is not used for this operation.
# Optional: leave unset to use the Codex default model for the signed-in account.
# CODEX_PERSONA_MODEL=

# Optional Arena provider profiles. Without this setting Arena uses NEBIUS_*.
# apiKeyEnv names an environment variable; never put a literal key in the JSON.
# Each endpoint must support the Codex Responses protocol.
# ARENA_PROVIDERS='[{"id":"nebius","name":"Nebius","baseUrl":"https://api.tokenfactory.nebius.com/v1","apiKeyEnv":"NEBIUS_API_KEY"},{"id":"other","name":"Other provider","baseUrl":"https://api.example.com/v1","apiKeyEnv":"OTHER_API_KEY","defaultModel":"model-id"}]'
# OTHER_API_KEY=

# Speech API and local transcription (included in npm run start:web).
SPEECH_SERVICE_URL=http://127.0.0.1:8764
SPEECH_PORT=8764
SPEECH_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:3011,http://localhost:3011
LOCAL_ASR_URL=http://127.0.0.1:8765
LOCAL_ASR_MODEL=mlx-community/nemotron-3.5-asr-streaming-0.6b-8bit
# English by default; use auto for automatic language detection.
LOCAL_ASR_LANGUAGE=en

# Voice provider: local (default) or elevenlabs. Restart the speech owner after changes.
TTS_PROVIDER=local
# Required only for elevenlabs. Keep the API key on the server.
ELEVENLABS_API_KEY=
# Optional voice and model overrides; blank or unset values use these defaults.
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Local voice settings are used only with TTS_PROVIDER=local.
LOCAL_TTS_URL=http://127.0.0.1:8766
LOCAL_TTS_MODEL=mlx-community/Voxtral-4B-TTS-2603-mlx-4bit
LOCAL_TTS_VOICE=neutral_female
